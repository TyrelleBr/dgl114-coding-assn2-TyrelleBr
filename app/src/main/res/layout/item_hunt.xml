<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#0B1120"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/pokemonImage"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="pokemon sprite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <TextView
        android:id="@+id/pokemonName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Cubone"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/pokemonImage"
        app:layout_constraintTop_toTopOf="@id/pokemonImage"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/pokemonGameName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Pokemon Fire Red"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="normal"
        app:layout_constraintTop_toBottomOf="@id/pokemonName"
        app:layout_constraintStart_toEndOf="@id/pokemonImage"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/numOfEncounters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Encounters: "
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="normal"
        app:layout_constraintTop_toBottomOf="@id/pokemonGameName"
        app:layout_constraintStart_toEndOf="@id/pokemonImage"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageView
        android:id="@+id/startHuntButton"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:tint="#4ADE80"
        android:src="@android:drawable/ic_media_play"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"

        />

</androidx.constraintlayout.widget.ConstraintLayout>